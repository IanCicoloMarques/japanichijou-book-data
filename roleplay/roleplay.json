{
  "Credits": "<align=center><b>Voice credits</b></align>\n<size=80%>TTS: Microsoft Edge (ja-JP-NanamiNeural, ja-JP-KeitaNeural)</size>",
  "Scenarios": [
    {
      "Id": "restaurant_polite",
      "Title": "レストラン（丁寧）",
      "Category": "Restaurant",
      "Level": "N5",
      "Tags": [
        "Polite",
        "Going Out",
        "Good for Beginners"
      ],
      "Roles": [
        {
          "Name": "Clerk",
          "Color": "#1F5FBF"
        },
        {
          "Name": "Customer",
          "Color": "#1FA3B5"
        }
      ],
      "Lines": [
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 1,
              "Japanese": "いらっしゃいませ。何名様ですか？",
              "Hiragana": "いらっしゃいませ。なんめいさまですか？",
              "Romaji": "irasshaimase. nanmei-sama desu ka?",
              "English": "Welcome. How many people?",
              "AudioStart": 0.12,
              "AudioDuration": 4.332
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 2,
              "Japanese": "2人です。",
              "Hiragana": "ふたりです。",
              "Romaji": "futari desu.",
              "English": "Two people.",
              "AudioStart": 6.12,
              "AudioDuration": 2.052
            },
            {
              "AudioId": 3,
              "Japanese": "2名です。",
              "Hiragana": "にめいです。",
              "Romaji": "nimei desu.",
              "English": "Two people. (formal)",
              "AudioStart": 10.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 4,
              "Japanese": "こちらのお席へどうぞ。",
              "Hiragana": "こちらのおせきへどうぞ。",
              "Romaji": "kochira no oseki e douzo.",
              "English": "Please take this seat.",
              "AudioStart": 14.12,
              "AudioDuration": 2.7
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 5,
              "Japanese": "ありがとうございます。",
              "Hiragana": "ありがとうございます。",
              "Romaji": "arigatou gozaimasu.",
              "English": "Thank you.",
              "AudioStart": 18.12,
              "AudioDuration": 2.412
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 6,
              "Japanese": "ご注文はお決まりですか？",
              "Hiragana": "ごちゅうもんはおきまりですか？",
              "Romaji": "gochuumon wa okimari desu ka?",
              "English": "Are you ready to order?",
              "AudioStart": 22.12,
              "AudioDuration": 3.084
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 7,
              "Japanese": "ラーメンを一つください。",
              "Hiragana": "らーめんをひとつください。",
              "Romaji": "raamen o hitotsu kudasai.",
              "English": "One ramen, please.",
              "AudioStart": 26.12,
              "AudioDuration": 2.484
            },
            {
              "AudioId": 8,
              "Japanese": "カレーライスを一つお願いします。",
              "Hiragana": "かれーらいすをひとつおねがいします。",
              "Romaji": "karee raisu o hitotsu onegai shimasu.",
              "English": "One curry rice, please.",
              "AudioStart": 30.12,
              "AudioDuration": 3.108
            },
            {
              "AudioId": 9,
              "Japanese": "おすすめは何ですか？",
              "Hiragana": "おすすめはなんですか？",
              "Romaji": "osusume wa nan desu ka?",
              "English": "What do you recommend?",
              "AudioStart": 34.12,
              "AudioDuration": 2.388
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 10,
              "Japanese": "お飲み物はいかがですか？",
              "Hiragana": "おのみものはいかがですか？",
              "Romaji": "onomimono wa ikaga desu ka?",
              "English": "Would you like something to drink?",
              "AudioStart": 38.12,
              "AudioDuration": 2.82
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 11,
              "Japanese": "お水をお願いします。",
              "Hiragana": "おみずをおねがいします。",
              "Romaji": "omizu o onegai shimasu.",
              "English": "Water, please.",
              "AudioStart": 42.12,
              "AudioDuration": 2.484
            },
            {
              "AudioId": 12,
              "Japanese": "大丈夫です。",
              "Hiragana": "だいじょうぶです。",
              "Romaji": "daijoubu desu.",
              "English": "I'm fine, thank you.",
              "AudioStart": 46.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 13,
              "Japanese": "かしこまりました。少々お待ちください。",
              "Hiragana": "かしこまりました。しょうしょうおまちください。",
              "Romaji": "kashikomarimashita. shoushou omachi kudasai.",
              "English": "Certainly. Please wait a moment.",
              "AudioStart": 50.12,
              "AudioDuration": 4.668
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 14,
              "Japanese": "すみません、お会計をお願いします。",
              "Hiragana": "すみません、おかいけいをおねがいします。",
              "Romaji": "sumimasen, okaikei o onegai shimasu.",
              "English": "Excuse me, the check, please.",
              "AudioStart": 56.12,
              "AudioDuration": 3.684
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 15,
              "Japanese": "1200円です。",
              "Hiragana": "せんにひゃくえんです。",
              "Romaji": "sen nihyaku en desu.",
              "English": "That will be 1,200 yen.",
              "AudioStart": 60.12,
              "AudioDuration": 2.58
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 16,
              "Japanese": "カードで払えますか？",
              "Hiragana": "かーどではらえますか？",
              "Romaji": "kaado de haraemasu ka?",
              "English": "Can I pay by card?",
              "AudioStart": 64.12,
              "AudioDuration": 2.268
            },
            {
              "AudioId": 17,
              "Japanese": "現金でお願いします。",
              "Hiragana": "げんきんでおねがいします。",
              "Romaji": "genkin de onegai shimasu.",
              "English": "In cash, please.",
              "AudioStart": 68.12,
              "AudioDuration": 2.604
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 18,
              "Japanese": "ありがとうございました。またお越しください。",
              "Hiragana": "ありがとうございました。またおこしください。",
              "Romaji": "arigatou gozaimashita. mata okoshi kudasai.",
              "English": "Thank you very much. Please come again.",
              "AudioStart": 72.12,
              "AudioDuration": 4.716
            }
          ]
        }
      ]
    },
    {
