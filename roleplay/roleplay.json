      ],
      "Lines": [
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 19,
              "Japanese": "いらっしゃい！何名？",
              "Hiragana": "いらっしゃい！なんめい？",
              "Romaji": "irasshai! nanmei?",
              "English": "Welcome! How many?",
              "AudioStart": 78.12,
              "AudioDuration": 3.42
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 20,
              "Japanese": "2人。",
              "Hiragana": "ふたり。",
              "Romaji": "futari.",
              "English": "Two.",
              "AudioStart": 82.12,
              "AudioDuration": 2.052
            },
            {
              "AudioId": 21,
              "Japanese": "2人で。",
              "Hiragana": "ふたりで。",
              "Romaji": "futari de.",
              "English": "For two.",
              "AudioStart": 86.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 22,
              "Japanese": "そこ、空いてるよ。",
              "Hiragana": "そこ、あいてるよ。",
              "Romaji": "soko, aiteru yo.",
              "English": "That seat is free.",
              "AudioStart": 90.12,
              "AudioDuration": 2.412
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 23,
              "Japanese": "どうも。",
              "Hiragana": "どうも。",
              "Romaji": "doumo.",
              "English": "Thanks.",
              "AudioStart": 94.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 24,
              "Japanese": "何にする？",
              "Hiragana": "なんにする？",
              "Romaji": "nan ni suru?",
              "English": "What will you have?",
              "AudioStart": 98.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 25,
              "Japanese": "ラーメン一つ。",
              "Hiragana": "らーめんひとつ。",
              "Romaji": "raamen hitotsu.",
              "English": "One ramen.",
              "AudioStart": 102.12,
              "AudioDuration": 2.052
            },
            {
              "AudioId": 26,
              "Japanese": "餃子も一つ。",
              "Hiragana": "ぎょうざもひとつ。",
              "Romaji": "gyouza mo hitotsu.",
              "English": "And one gyoza, too.",
              "AudioStart": 106.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 27,
              "Japanese": "飲み物は？",
              "Hiragana": "のみものは？",
              "Romaji": "nomimono wa?",
              "English": "Drinks?",
              "AudioStart": 110.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 28,
              "Japanese": "水でいいよ。",
              "Hiragana": "みずでいいよ。",
              "Romaji": "mizu de ii yo.",
              "English": "Water is fine.",
              "AudioStart": 114.12,
              "AudioDuration": 2.052
            },
            {
              "AudioId": 29,
              "Japanese": "いらない。",
              "Hiragana": "いらない。",
              "Romaji": "iranai.",
              "English": "No, thanks.",
              "AudioStart": 118.12,
              "AudioDuration": 2.052
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 30,
              "Japanese": "はーい、ちょっと待ってね。",
              "Hiragana": "はーい、ちょっとまってね。",
              "Romaji": "haai, chotto matte ne.",
              "English": "Okay, just a moment.",
              "AudioStart": 122.12,
              "AudioDuration": 2.916
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 31,
              "Japanese": "ごちそうさま！いくら？",
              "Hiragana": "ごちそうさま！いくら？",
              "Romaji": "gochisousama! ikura?",
              "English": "Thanks for the meal! How much?",
              "AudioStart": 126.12,
              "AudioDuration": 3.276
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 32,
              "Japanese": "900円ね。",
              "Hiragana": "きゅうひゃくえんね。",
              "Romaji": "kyuuhyaku en ne.",
              "English": "900 yen.",
              "AudioStart": 130.12,
              "AudioDuration": 2.22
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 33,
              "Japanese": "はい、これで。",
              "Hiragana": "はい、これで。",
              "Romaji": "hai, kore de.",
              "English": "Here you go.",
              "AudioStart": 134.12,
              "AudioDuration": 2.22
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 34,
              "Japanese": "まいど！また来てね。",
              "Hiragana": "まいど！またきてね。",
              "Romaji": "maido! mata kite ne.",
              "English": "Thanks! Come again.",
              "AudioStart": 138.12,
              "AudioDuration": 3.42
            }
          ]
        }
      ]
    },
    {
      "Id": "cafe_friends",
      "Title": "カフェで友達と",
      "Category": "Cafe",
      "Level": "N5",
      "Tags": [
        "Casual",
        "Polite",
        "Going Out",
        "Friends"
      ],
      "Roles": [
        {
          "Name": "Staff",
          "Color": "#C0392B"
        },
        {
          "Name": "Aki",
          "Color": "#2E86DE"
        },
        {
          "Name": "Yuki",
          "Color": "#27AE60"
        }
      ],
      "Lines": [
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 35,
              "Japanese": "いらっしゃいませ。ご注文をどうぞ。",
              "Hiragana": "いらっしゃいませ。ごちゅうもんをどうぞ。",
              "Romaji": "irasshaimase. gochuumon o douzo.",
              "English": "Welcome. What would you like?",
              "AudioStart": 142.12,
              "AudioDuration": 4.332
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 36,
              "Japanese": "ユキは何にする？",
              "Hiragana": "ゆきはなににする？",
              "Romaji": "Yuki wa nani ni suru?",
              "English": "Yuki, what are you getting?",
              "AudioStart": 148.12,
              "AudioDuration": 2.22
            }
          ]
        },
        {
          "Role": 2,
          "Options": [
            {
              "AudioId": 37,
              "Japanese": "ケーキセットにしようかな。",
              "Hiragana": "けーきせっとにしようかな。",
              "Romaji": "keeki setto ni shiyou ka na.",
              "English": "Maybe the cake set.",
              "AudioStart": 152.12,
              "AudioDuration": 2.844
            },
            {
              "AudioId": 38,
              "Japanese": "チーズケーキがいいな。",
              "Hiragana": "ちーずけーきがいいな。",
              "Romaji": "chiizu keeki ga ii na.",
              "English": "Cheesecake sounds good.",
              "AudioStart": 156.12,
              "AudioDuration": 2.604
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 39,
              "Japanese": "いいね。私も同じのにする。",
              "Hiragana": "いいね。わたしもおなじのにする。",
              "Romaji": "ii ne. watashi mo onaji no ni suru.",
              "English": "Nice. I will get the same.",
              "AudioStart": 160.12,
              "AudioDuration": 3.804
            },
            {
              "AudioId": 40,
              "Japanese": "僕はコーヒーだけでいいや。",
              "Hiragana": "ぼくはこーひーだけでいいや。",
              "Romaji": "boku wa koohii dake de ii ya.",
              "English": "Just coffee for me.",
              "AudioStart": 164.12,
              "AudioDuration": 2.58
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 41,
              "Japanese": "お飲み物はホットとアイス、どちらになさいますか？",
              "Hiragana": "おのみものはほっととあいす、どちらになさいますか？",
              "Romaji": "onomimono wa hotto to aisu, dochira ni nasaimasu ka?",
              "English": "Would you like your drinks hot or iced?",
              "AudioStart": 168.12,
              "AudioDuration": 4.572
            }
          ]
        },
        {
          "Role": 2,
          "Options": [
            {
              "AudioId": 42,
              "Japanese": "ホットでお願いします。",
              "Hiragana": "ほっとでおねがいします。",
              "Romaji": "hotto de onegai shimasu.",
              "English": "Hot, please.",
              "AudioStart": 174.12,
              "AudioDuration": 2.628
            },
            {
              "AudioId": 43,
              "Japanese": "アイスでお願いします。",
              "Hiragana": "あいすでおねがいします。",
              "Romaji": "aisu de onegai shimasu.",
              "English": "Iced, please.",
              "AudioStart": 178.12,
              "AudioDuration": 2.628
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 44,
              "Japanese": "私も同じで。",
              "Hiragana": "わたしもおなじで。",
              "Romaji": "watashi mo onaji de.",
              "English": "Same for me.",
              "AudioStart": 182.12,
              "AudioDuration": 2.172
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 45,
              "Japanese": "かしこまりました。お会計はご一緒ですか？",
              "Hiragana": "かしこまりました。おかいけいはごいっしょですか？",
              "Romaji": "kashikomarimashita. okaikei wa goissho desu ka?",
              "English": "Certainly. Will you be paying together?",
              "AudioStart": 186.12,
              "AudioDuration": 4.908
            }
          ]
        },
        {
          "Role": 1,
          "Options": [
            {
              "AudioId": 46,
              "Japanese": "別々でお願いします。",
              "Hiragana": "べつべつでおねがいします。",
              "Romaji": "betsubetsu de onegai shimasu.",
              "English": "Separately, please.",
              "AudioStart": 192.12,
              "AudioDuration": 2.652
            },
            {
              "AudioId": 47,
              "Japanese": "一緒でお願いします。",
              "Hiragana": "いっしょでおねがいします。",
              "Romaji": "issho de onegai shimasu.",
              "English": "Together, please.",
              "AudioStart": 196.12,
              "AudioDuration": 2.484
            }
          ]
        },
        {
          "Role": 0,
          "Options": [
            {
              "AudioId": 48,
              "Japanese": "ごゆっくりどうぞ。",
              "Hiragana": "ごゆっくりどうぞ。",
              "Romaji": "goyukkuri douzo.",
              "English": "Please enjoy your time.",
              "AudioStart": 200.12,
              "AudioDuration": 2.316
            }
          ]
        },
        {
          "Role": 2,
          "Options": [
            {
              "AudioId": 49,
              "Japanese": "ここ、雰囲気いいね。",
              "Hiragana": "ここ、ふんいきいいね。",
              "Romaji": "koko, fun-iki ii ne.",
              "English": "This place has a nice atmosphere.",
              "AudioStart": 204.12,
              "AudioDuration": 2.892
            }
          ]
        }
      ]
    }
  ]
